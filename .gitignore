# ==========================================
# 1. Personal & Environment Secrets
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

# ==========================================
# 2. Python-Specific Exclusions
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv
env/
venv/
ENV/

# Testing, Coverage, and Type Checkers
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ==========================================
# 3. Build & Package Manager Artifacts
# ==========================================
dist/
build/
out/
bin/
obj/
*.egg-info/
*.egg
node_modules/
jspm_packages/
.pnp/
.pnp.js

# ==========================================
# 4. Operating System & IDE Files
# ==========================================
# System files
.DS_Store
Thumbs.db
*.ini

# Editors and IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.ipynb_checkpoints

# ==========================================
# 5. Logs and Diagnostics
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*