{
  "info": {
    "name": "UC2 IBM Verify Setup - MCP Agent",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tenant_url",
      "value": "https://<tenant>"
    },
    {
      "key": "admin_client_id",
      "value": ""
    },
    {
      "key": "admin_client_secret",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    },
    {
      "key": "actor_client_id",
      "value": ""
    },
    {
      "key": "actor_client_secret",
      "value": ""
    },
    {
      "key": "agent_id",
      "value": ""
    },
    {
      "key": "actor_scope",
      "value": "agent.run"
    },
    {
      "key": "resource_client_id",
      "value": ""
    },
    {
      "key": "resource_client_secret",
      "value": ""
    },
    {
      "key": "actor_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Get Admin Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/oauth2/token",
          "host": [
            "{{tenant_url}}"
          ],
          "path": [
            "oauth2",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{admin_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{admin_client_secret}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) { const v = pm.response.json().access_token; if (v) pm.collectionVariables.set(\"admin_access_token\", v); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - DCR - Create UC2 Actor Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/oauth2/register",
          "host": [
            "{{tenant_url}}"
          ],
          "path": [
            "oauth2",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_name\": \"UC2 Course MCP Conversational Agent\",\n  \"grant_types\": [\n    \"client_credentials\"\n  ],\n  \"scope\": \"agent.run\",\n  \"token_endpoint_auth_method\": \"client_secret_post\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) { const v = pm.response.json(); if (v.client_id) pm.collectionVariables.set(\"actor_client_id\", v.client_id); if (v.client_secret) pm.collectionVariables.set(\"actor_client_secret\", v.client_secret); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Onboard Agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/scim+json"
          },
          {
            "key": "Accept",
            "value": "application/scim+json"
          }
        ],
        "url": "{{tenant_url}}/v1.0/Agents",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"schemas\": [\n    \"urn:ietf:params:scim:schemas:core:ibm:2.0:Agent\"\n  ],\n  \"displayName\": \"UC2 Course MCP Conversational Agent\",\n  \"description\": \"Conversational AI agent that invokes protected course tools\",\n  \"permissions\": [],\n  \"tags\": [\n    \"course-agent\",\n    \"mcp-tools\",\n    \"conversational-ai\"\n  ]\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) { const v = pm.response.json().id; if (v) pm.collectionVariables.set(\"agent_id\", v); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Get Agent Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Accept",
            "value": "application/scim+json"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/v1.0/Agents/{{agent_id}}",
          "host": [
            "{{tenant_url}}"
          ],
          "path": [
            "v1.0",
            "Agents",
            "{{agent_id}}"
          ]
        }
      }
    },
    {
      "name": "05 - DCR - Associate Actor Client with Agent",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{tenant_url}}/oauth2/register/{{actor_client_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_name\": \"UC2 Course MCP Conversational Agent\",\n  \"grant_types\": [\n    \"client_credentials\"\n  ],\n  \"extension\": {\n    \"entity_id\": \"{{agent_id}}\",\n    \"entity_type\": \"agent\"\n  },\n  \"scope\": \"agent.run\",\n  \"token_endpoint_auth_method\": \"client_secret_post\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - Activate Agent",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/scim+json"
          },
          {
            "key": "Accept",
            "value": "application/scim+json"
          }
        ],
        "url": "{{tenant_url}}/v1.0/Agents/{{agent_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"schemas\": [\n    \"urn:ietf:params:scim:schemas:core:ibm:2.0:Agent\"\n  ],\n  \"displayName\": \"UC2 Course MCP Conversational Agent\",\n  \"description\": \"Conversational AI agent that invokes protected course tools\",\n  \"permissions\": [],\n  \"tags\": [\n    \"course-agent\",\n    \"mcp-tools\",\n    \"conversational-ai\"\n  ],\n  \"status\": \"ACTIVE\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 - Suspend Agent",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/scim+json"
          },
          {
            "key": "Accept",
            "value": "application/scim+json"
          }
        ],
        "url": "{{tenant_url}}/v1.0/Agents/{{agent_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"schemas\": [\n    \"urn:ietf:params:scim:schemas:core:ibm:2.0:Agent\"\n  ],\n  \"displayName\": \"UC2 Course MCP Conversational Agent\",\n  \"description\": \"Conversational AI agent that invokes protected course tools\",\n  \"permissions\": [],\n  \"tags\": [\n    \"course-agent\",\n    \"mcp-tools\",\n    \"conversational-ai\"\n  ],\n  \"status\": \"SUSPENDED\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 - Get Actor Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/oauth2/token",
          "host": [
            "{{tenant_url}}"
          ],
          "path": [
            "oauth2",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{actor_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{actor_client_secret}}",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{actor_scope}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) { const v = pm.response.json().access_token; if (v) pm.collectionVariables.set(\"actor_access_token\", v); }"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Register MCP ADT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{tenant_url}}/oidc-mgmt/v1.0/auth-detail-types",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"urn:ibm:demo:verify:agent_action\",\n  \"schema\": \"{\\\"description\\\": \\\"Agent action authorization details for the IBM Verify conversational AI MCP tools sample\\\", \\\"type\\\": \\\"object\\\", \\\"required\\\": [\\\"type\\\", \\\"courseId\\\", \\\"operationDetails\\\"], \\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"type\\\": {\\\"type\\\": \\\"string\\\", \\\"const\\\": \\\"urn:ibm:demo:verify:agent_action\\\"}, \\\"courseId\\\": {\\\"type\\\": \\\"string\\\"}, \\\"operationDetails\\\": {\\\"type\\\": \\\"object\\\", \\\"required\\\": [\\\"creator\\\", \\\"affectedPerson\\\", \\\"loggedInSubject\\\", \\\"action\\\", \\\"targetSystem\\\", \\\"resource\\\", \\\"toolName\\\", \\\"downstreamSystem\\\"], \\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"creator\\\": {\\\"type\\\": \\\"string\\\"}, \\\"affectedPerson\\\": {\\\"type\\\": \\\"string\\\"}, \\\"loggedInSubject\\\": {\\\"type\\\": \\\"string\\\"}, \\\"action\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"list_available_courses\\\", \\\"list_enrolled_courses\\\", \\\"enroll_course\\\", \\\"delete_course_history\\\"]}, \\\"targetSystem\\\": {\\\"type\\\": \\\"string\\\"}, \\\"resource\\\": {\\\"type\\\": \\\"string\\\"}, \\\"toolName\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"list_available_courses\\\", \\\"list_enrolled_courses\\\", \\\"enroll_course\\\", \\\"delete_course_history\\\"]}, \\\"downstreamSystem\\\": {\\\"type\\\": \\\"string\\\"}}}}}\",\n  \"inlineMode\": true,\n  \"description\": \"Agent action authorization details for the Course Agent sample\",\n  \"useCustomMapping\": false,\n  \"signatureStrategy\": \"full_hash\",\n  \"consentInlineText\": \"JE9JRENfQVVUSERFVEFJTF9MQUJFTF9TVERUSVRMRSQ8YnIvPiRPSURDX0FVVEhERVRBSUxfTEFCRUxfU1RESUQkIHthZC5pZGVudGlmaWVyfQ\",\n  \"consentLabel\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 - Introspect Actor Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/oauth2/introspect",
          "host": [
            "{{tenant_url}}"
          ],
          "path": [
            "oauth2",
            "introspect"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "token",
              "value": "{{actor_access_token}}",
              "type": "text"
            }
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{resource_client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{resource_client_secret}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
